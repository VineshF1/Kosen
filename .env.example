# NVIDIA API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# GitHub API (for PR review integration)
# Create a personal access token at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Static Analysis Tools (optional - defaults to PATH)
SEMGREP_PATH=semgrep
RUFF_PATH=ruff
DIFF_COVER_PATH=diff-cover

# Benchmark Settings
BENCHMARK_DATASET_DIR=benchmark/dataset
BENCHMARK_MAX_VULNS=100

# Application Settings
APP_LOG_LEVEL=INFO